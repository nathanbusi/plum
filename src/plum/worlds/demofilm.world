<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_test">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Outer Walls -->
    <model name="outer_walls">
      <static>true</static>
      <link name="walls">

        <!-- Wall template -->
        <visual name="north">
          <pose>0 10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="north">
          <pose>0 10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>

        <visual name="south">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="south">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>

        <visual name="west">
          <pose>-10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="west">
          <pose>-10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </collision>

        <visual name="east">
          <pose>10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="east">
          <pose>10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </collision>

      </link>
    </model>

    <!-- Corridor -->
    <model name="corridor">
      <static>true</static>
      <link name="walls">
        <visual name="c_wall1">
          <pose>-7 -6 0.5 0 0 0</pose>
          <geometry><box><size>0.2 8 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="c_wall1">
          <pose>-7 -6 0.5 0 0 0</pose>
          <geometry><box><size>0.2 8 1</size></box></geometry>
        </collision>

        <visual name="c_wall2">
          <pose>-3 -6 0.5 0 0 0</pose>
          <geometry><box><size>0.2 8 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="c_wall2">
          <pose>-3 -6 0.5 0 0 0</pose>
          <geometry><box><size>0.2 8 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Room 1 -->
    <model name="room_1">
      <static>true</static>
      <link name="walls">
        <!-- West -->
        <visual name="r1_west">
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r1_west">
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <!-- East -->
        <visual name="r1_east">
          <pose>7.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r1_east">
          <pose>7.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <!-- North -->
        <visual name="r1_north">
          <pose>5 5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r1_north">
          <pose>5 5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </collision>

        <!-- South split (gap in middle) -->
        <visual name="r1_south_left">
          <pose>3.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r1_south_left">
          <pose>3.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </collision>

        <visual name="r1_south_right">
          <pose>6.75 0 0.5 0 0 0</pose>
          <geometry><box><size>1.5 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r1_south_right">
          <pose>6.75 0 0.5 0 0 0</pose>
          <geometry><box><size>1.5 0.2 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Room 2 -->
    <model name="room_2">
      <static>true</static>
      <link name="walls">
        <visual name="r2_west">
          <pose>-7.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r2_west">
          <pose>-7.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r2_east">
          <pose>-2.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r2_east">
          <pose>-2.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r2_north">
          <pose>-6 7.5 0.5 0 0 0</pose>
          <geometry><box><size>3 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r2_north">
          <pose>-6 7.5 0.5 0 0 0</pose>
          <geometry><box><size>3 0.2 1</size></box></geometry>
        </collision>

        <visual name="r2_south">
          <pose>-5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <collision name="r2_south">
          <pose>-5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Pillars -->
    <!-- Repeatable pillar model with texture -->
    <model name="pillar_1">
      <static>true</static>
      <link name="pillar">
        <pose>1 -4 0.5 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="col"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <link name="pillar">
        <pose>5 7.5 0.5 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="col"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <link name="pillar">
        <pose>8 -5 0.5 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="col"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <link name="pillar">
        <pose>3 7.5 0.5 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
        <collision name="col"><geometry><box><size>0.6 0.6 1</size></box></geometry></collision>
      </link>
    </model>

    <model name="pillar_5">
      <static>true</static>
      <link name="pillar">
        <pose>4 -6 0.5 0 0 0</pose>
        <visual name="vis"><geometry><box><size>0.6 0.6 1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>

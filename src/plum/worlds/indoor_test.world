<sdf version="1.6">
  <world name="indoor_test">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Smaller U-shape wall around spawn (2x2m) -->
    <model name="spawn_shroud_small">
      <static>true</static>
      <link name="walls">
        <!-- Back wall -->
        <visual name="u_back">
          <pose>0 -1 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </visual>
        <collision name="u_back">
          <pose>0 -1 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </collision>

        <!-- Left wall -->
        <visual name="u_left">
          <pose>-1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 2 1</size></box></geometry>
        </visual>
        <collision name="u_left">
          <pose>-1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 2 1</size></box></geometry>
        </collision>

        <!-- Right wall -->
        <visual name="u_right">
          <pose>1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 2 1</size></box></geometry>
        </visual>
        <collision name="u_right">
          <pose>1 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 2 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Outer Walls (20x20 Arena) -->
    <model name="outer_walls">
      <static>true</static>
      <link name="walls">
        <visual name="north">
          <pose>0 10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </visual>
        <collision name="north">
          <pose>0 10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>

        <visual name="south">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </visual>
        <collision name="south">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry><box><size>20 0.2 1</size></box></geometry>
        </collision>

        <visual name="west">
          <pose>-10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </visual>
        <collision name="west">
          <pose>-10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </collision>

        <visual name="east">
          <pose>10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </visual>
        <collision name="east">
          <pose>10 0 0.5 0 0 0</pose>
          <geometry><box><size>0.2 20 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Corridor (Widened to 3m) -->
    <model name="corridor">
      <static>true</static>
      <link name="walls">
        <visual name="c_wall1">
          <pose>-6 -5.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </visual>
        <collision name="c_wall1">
          <pose>-6 -5.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </collision>

        <visual name="c_wall2">
          <pose>-3 -5.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </visual>
        <collision name="c_wall2">
          <pose>-3 -5.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 10 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Room 1 (5x5m) with doorway gap -->
    <model name="room_1">
      <static>true</static>
      <link name="walls">
        <visual name="r1_west">
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </visual>
        <collision name="r1_west">
          <pose>2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r1_east">
          <pose>7.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </visual>
        <collision name="r1_east">
          <pose>7.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r1_north">
          <pose>5 5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </visual>
        <collision name="r1_north">
          <pose>5 5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </collision>

        <!-- South split for doorway -->
        <visual name="r1_south_left">
          <pose>3.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </visual>
        <collision name="r1_south_left">
          <pose>3.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </collision>

        <visual name="r1_south_right">
          <pose>6.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </visual>
        <collision name="r1_south_right">
          <pose>6.5 0 0.5 0 0 0</pose>
          <geometry><box><size>2 0.2 1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Room 2 (also 5x5m) -->
    <model name="room_2">
      <static>true</static>
      <link name="walls">
        <visual name="r2_west">
          <pose>-7.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </visual>
        <collision name="r2_west">
          <pose>-7.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r2_east">
          <pose>-2.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </visual>
        <collision name="r2_east">
          <pose>-2.5 5 0.5 0 0 0</pose>
          <geometry><box><size>0.2 5 1</size></box></geometry>
        </collision>

        <visual name="r2_north">
          <pose>-5 7.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </visual>
        <collision name="r2_north">
          <pose>-5 7.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </collision>

        <visual name="r2_south">
          <pose>-5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </visual>
        <collision name="r2_south">
          <pose>-5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>5 0.2 1</size></box></geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>

